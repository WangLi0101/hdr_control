<Project><PropertyGroup>
 <Configuration>Release</Configuration><RuntimeIdentifier>win-arm64</RuntimeIdentifier>
 <SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
 <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
 <PublishTrimmed>false</PublishTrimmed><DebugType>None</DebugType>
 <PublishDir>$(MSBuildProjectDirectory)/../artifacts/win-arm64/</PublishDir>
</PropertyGroup></Project>
