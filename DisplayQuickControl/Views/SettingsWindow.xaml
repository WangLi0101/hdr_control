<Window x:Class="DisplayQuickControl.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Display Quick Control · Settings" Width="570" Height="750" MinWidth="450" MinHeight="450" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Configure your display shortcuts" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
   <StackPanel>
    <TextBlock Style="{StaticResource Section}" Text="COLORCONTROL"/>
    <TextBlock Text="ColorControl.exe path" Margin="0,0,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding Draft.ColorControlPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ColorControl executable path"/>
     <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
    </Grid>
    <TextBlock Style="{StaticResource Section}" Text="DISPLAY MODES" Margin="0,18,0,8"/>
    <ItemsControl ItemsSource="{Binding Modes}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource Card}" CornerRadius="6" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Hotkey}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="自定义模式…" Click="CustomizeModesClick" HorizontalAlignment="Left" Margin="0,4,0,8"/>
    <TextBlock Text="添加、编辑、删除或排序模式，并配置每个模式的预设和快捷键。此处的更改需点击下方 Save settings 才会生效。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,18"/>
    <TextBlock Style="{StaticResource Section}" Text="STARTUP"/>
    <CheckBox Content="Start with Windows" IsChecked="{Binding Draft.StartWithWindows}"/>
    <TextBlock Style="{StaticResource Section}" Text="BEHAVIOR" Margin="0,18,0,4"/>
    <CheckBox Content="Close panel when clicking outside" IsChecked="{Binding Draft.CloseOnDeactivate}"/>
    <CheckBox Content="Refresh display state when panel opens" IsChecked="{Binding Draft.RefreshOnOpen}"/>
    <TextBlock Style="{StaticResource Section}" Text="GLOBAL HOTKEYS" Margin="0,18,0,4"/>
    <CheckBox Content="Enable global hotkeys" IsChecked="{Binding Draft.HotkeysEnabled}"/>
    <TextBlock Text="每个模式的快捷键可在“自定义模式”窗口中编辑，留空可关闭单个快捷键。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,20"/>
    <TextBlock Style="{StaticResource Section}" Text="APPEARANCE"/>
    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Draft.Theme}" Margin="0,0,0,18" AutomationProperties.Name="Theme"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Warning}" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="CancelClick" MinWidth="90" Margin="0,0,8,0"/><Button Content="Save settings" Command="{Binding SaveCommand}" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" MinWidth="120"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
