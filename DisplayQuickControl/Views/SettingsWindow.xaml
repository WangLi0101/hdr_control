<Window x:Class="DisplayQuickControl.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Display Quick Control · Settings" Width="570" Height="750" MinWidth="450" MinHeight="450" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Configure your display shortcuts" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
   <StackPanel>
    <TextBlock Style="{StaticResource Section}" Text="COLORCONTROL"/>
    <TextBlock Text="ColorControl.exe path" Margin="0,0,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding Draft.ColorControlPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ColorControl executable path"/>
     <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
    </Grid>
    <TextBlock Text="Preset names must match your NVIDIA presets in ColorControl. Each preset must explicitly include HDR, refresh rate and color settings." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,14"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="HDR · 144 Hz" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Draft.HdrPreset, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="HDR preset name"/>
     <TextBlock Grid.Row="1" Text="SDR · 180 Hz" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.SdrPreset, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="SDR preset name"/>
     <TextBlock Grid.Row="2" Text="HDR Safe · 120 Hz" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Draft.SafePreset, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="HDR Safe preset name"/>
    </Grid>
    <TextBlock Text="Select the monitor in the control panel. Your ColorControl presets must target the same monitor; this app does not rewrite them." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,20"/>
    <TextBlock Style="{StaticResource Section}" Text="STARTUP"/>
    <CheckBox Content="Start with Windows" IsChecked="{Binding Draft.StartWithWindows}"/>
    <TextBlock Style="{StaticResource Section}" Text="BEHAVIOR" Margin="0,18,0,4"/>
    <CheckBox Content="Close panel when clicking outside" IsChecked="{Binding Draft.CloseOnDeactivate}"/>
    <CheckBox Content="Refresh display state when panel opens" IsChecked="{Binding Draft.RefreshOnOpen}"/>
    <TextBlock Style="{StaticResource Section}" Text="GLOBAL HOTKEYS" Margin="0,18,0,4"/>
    <CheckBox Content="Enable global hotkeys" IsChecked="{Binding Draft.HotkeysEnabled}"/>
    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="HDR 144" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Draft.HdrHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="HDR hotkey"/>
     <TextBlock Grid.Row="1" Text="SDR 180" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.SdrHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="SDR hotkey"/>
     <TextBlock Grid.Row="2" Text="HDR Safe" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Draft.SafeHotkey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="HDR Safe hotkey"/>
    </Grid>
    <TextBlock Text="Use Ctrl, Alt, Shift or Win plus a letter or function key (for example Ctrl+Alt+H). Leave a field empty to disable that shortcut." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,20"/>
    <TextBlock Style="{StaticResource Section}" Text="APPEARANCE"/>
    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Draft.Theme}" Margin="0,0,0,18" AutomationProperties.Name="Theme"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Warning}" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="CancelClick" MinWidth="90" Margin="0,0,8,0"/><Button Content="Save settings" Command="{Binding SaveCommand}" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" MinWidth="120"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
