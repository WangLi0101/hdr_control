<Window x:Class="DisplayQuickControl.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="显示快捷控制 · 设置" Language="zh-CN" Width="570" Height="750" MinWidth="450" MinHeight="450" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="配置显示模式与快捷键" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
   <StackPanel>
    <TextBlock Style="{StaticResource Section}" Text="COLORCONTROL"/>
    <TextBlock Text="ColorControl.exe 路径" Margin="0,0,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding Draft.ColorControlPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ColorControl 程序路径"/>
     <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
    </Grid>
    <Button Content="初始化 ColorControl 预设" Command="{Binding InitializePresetsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    <TextBlock Text="为当前显示器补齐下方模式对应的预设；已有同名预设保留。请先退出 ColorControl。初始化立即写入配置，不切换显示模式。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/>
    <CheckBox Content="保存模式时同步到 ColorControl" IsChecked="{Binding Draft.SyncColorControlPresets}" Margin="0,10,0,0"/>
    <TextBlock Text="同步会更新同名预设的显示参数并备份原文件。默认颜色由 NVIDIA 决定；指定颜色使用 Full 动态范围。请先选择程序路径；未配置路径时只保存本工具设置。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/>
    <TextBlock Style="{StaticResource Section}" Text="显示模式" Margin="0,18,0,8"/>
    <ItemsControl ItemsSource="{Binding Modes}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource Card}" CornerRadius="6" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Hotkey}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="自定义模式…" Click="CustomizeModesClick" HorizontalAlignment="Left" Margin="0,4,0,8"/>
    <TextBlock Text="添加、编辑、删除或排序模式，并配置每个模式的预设和快捷键。此处的更改需点击下方“保存设置”才会生效。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,18"/>
    <TextBlock Style="{StaticResource Section}" Text="开机启动"/>
    <CheckBox Content="随 Windows 启动" IsChecked="{Binding Draft.StartWithWindows}"/>
    <TextBlock Style="{StaticResource Section}" Text="操作行为" Margin="0,18,0,4"/>
    <CheckBox Content="点击面板外部时隐藏面板" IsChecked="{Binding Draft.CloseOnDeactivate}"/>
    <CheckBox Content="打开面板时刷新显示状态" IsChecked="{Binding Draft.RefreshOnOpen}"/>
    <TextBlock Style="{StaticResource Section}" Text="全局快捷键" Margin="0,18,0,4"/>
    <CheckBox Content="启用全局快捷键" IsChecked="{Binding Draft.HotkeysEnabled}"/>
    <TextBlock Text="每个模式的快捷键可在“自定义模式”窗口中编辑，留空可关闭单个快捷键。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,20"/>
    <TextBlock Style="{StaticResource Section}" Text="外观"/>
    <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Draft.Theme}" Margin="0,0,0,18" AutomationProperties.Name="主题"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Warning}" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Click="CancelClick" MinWidth="90" Margin="0,0,8,0"/><Button Content="保存设置" Command="{Binding SaveCommand}" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" MinWidth="120"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
