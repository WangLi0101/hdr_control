<Window x:Class="DisplayQuickControl.Views.ModeEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Display Quick Control · 自定义模式" Width="760" Height="750" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="自定义显示模式" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="添加自己的模式、排列卡片，并设置每个模式的快捷键。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="模式列表 · 最多 32 个" Style="{StaticResource Section}"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Selected}" Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Stroke}" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="模式列表">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding PresetName}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0"><Button Content="添加" Command="{Binding AddCommand}" Margin="0,0,4,4"/><Button Content="删除" Command="{Binding DeleteCommand}" Margin="4,0,0,4"/><Button Content="上移" Command="{Binding UpCommand}" Margin="0,4,4,0"/><Button Content="下移" Command="{Binding DownCommand}" Margin="4,4,0,0"/></UniformGrid>
   </Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <StackPanel IsEnabled="{Binding HasSelection}">
     <TextBlock Text="模式名称" Margin="0,0,0,6"/><TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="模式名称"/>
     <TextBlock Text="ColorControl 预设名称" Margin="0,14,0,6"/><TextBox Text="{Binding Selected.PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="模式对应的 ColorControl 预设"/>
     <TextBlock Text="请先在 ColorControl 中创建同名 NVIDIA 预设；以下参数用于切换后校验，不会修改 ColorControl 预设。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,16"/>
     <TextBlock Text="目标分辨率" Margin="0,0,0,6"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Selected.Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="目标分辨率宽度"/><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox Grid.Column="2" Text="{Binding Selected.Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="目标分辨率高度"/></Grid>
     <TextBlock Text="目标刷新率（Hz，小数使用 .）" Margin="0,14,0,6"/><TextBox Text="{Binding Selected.Hertz, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="目标刷新率"/>
     <CheckBox Content="HDR 开启（未勾选表示 SDR）" IsChecked="{Binding Selected.Hdr}" Margin="0,14,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="色深（bit / channel）" Margin="0,0,0,6"/><TextBlock Grid.Column="2" Text="颜色编码" Margin="0,0,0,6"/>
      <ComboBox Grid.Row="1" ItemsSource="{Binding BitDepths}" SelectedItem="{Binding Selected.Bits}" AutomationProperties.Name="目标色深"/><ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Encodings}" SelectedItem="{Binding Selected.ColorEncoding}" AutomationProperties.Name="目标颜色编码"/>
     </Grid>
     <TextBlock Text="全局快捷键（可留空）" Margin="0,14,0,6"/><TextBox Text="{Binding Selected.Hotkey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模式快捷键"/>
     <TextBlock Text="例如 Ctrl+Alt+H 或 Ctrl+Shift+F8。是否全局启用由 Settings 控制。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,12"/>
     <CheckBox Content="设为手动安全备用模式" IsChecked="{Binding Selected.IsSafeFallback}"/>
     <TextBlock Text="最多指定一个。其他 HDR 模式失败时会提供切换按钮，始终由你点击，不会自动执行。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,12"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Warning}" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="CancelClick" IsCancel="True" Width="90" Margin="0,0,8,0"/><Button Content="保存模式" Command="{Binding SaveCommand}" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" Width="115"/></StackPanel></StackPanel>
 </Grid>
</Window>
