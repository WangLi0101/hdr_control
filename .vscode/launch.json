      "program": "${workspaceFolder}/DisplayQuickControl/bin/Debug/net10.0-windows/DisplayQuickControl.exe",
      "cwd": "${workspaceFolder}/DisplayQuickControl",
      "console": "internalConsole"
    },
    {
      "name": "Attach to DisplayQuickControl",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
